      "severity": "error",
      "category": "accessibility",
      "rule": "Container must have role=tablist",
      "check": "The .content-switcher element must have role=\"tablist\"",
      "fail_example": "<div class=\"content-switcher content-switcher--md\">",
      "pass_example": "<div class=\"content-switcher content-switcher--md\" role=\"tablist\" aria-label=\"...\">",
      "references": ["WCAG 4.1.2"],
  "source_rule_type": null,
  "rule_type": "manual_review",
  "source_severity": "high",
  "validation_status": "not_run"
},
    {
      "id": "PLATFORM-CODE-CONTENT-SWITCHER-AUDIT-002",
      "severity": "error",
      "category": "accessibility",
      "rule": "Container must have accessible name",
      "check": "role=tablist requires aria-label or aria-labelledby",
      "fail_example": "<div class=\"content-switcher\" role=\"tablist\">",
      "pass_example": "<div class=\"content-switcher\" role=\"tablist\" aria-label=\"View options\">",
      "references": ["WCAG 1.3.1", "WCAG 4.1.2"],
  "source_rule_type": null,
  "rule_type": "manual_review",
  "source_severity": "high",
  "validation_status": "not_run"
},
    {
