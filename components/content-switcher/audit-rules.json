      "severity": "error",
      "category": "accessibility",
      "rule": "Items must have role=tab with aria-selected",
      "check": "Each .content-switcher__item must have role=\"tab\" and aria-selected=\"true\" or aria-selected=\"false\"",
      "fail_example": "<button class=\"content-switcher__item\">",
      "pass_example": "<button class=\"content-switcher__item\" role=\"tab\" aria-selected=\"false\">",
      "references": ["WCAG 4.1.2"],
  "source_rule_type": null,
  "rule_type": "manual_review",
  "source_severity": "high",
  "validation_status": "not_run"
},
    {
      "id": "PLATFORM-CODE-CONTENT-SWITCHER-AUDIT-004",
      "severity": "error",
      "category": "accessibility",
      "rule": "Exactly one item must be selected at all times",
      "check": "Exactly one .content-switcher__item must have aria-selected=\"true\" at any given time",
      "references": ["ARIA tablist pattern"],
  "source_rule_type": null,
  "rule_type": "manual_review",
  "source_severity": "high",
  "validation_status": "not_run"
