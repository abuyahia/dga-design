      "check": "Active item must have tabindex=\"0\"; all other items must have tabindex=\"-1\"",
      "references": ["ARIA tablist pattern", "WCAG 2.1.1"],
  "source_rule_type": null,
  "rule_type": "manual_review",
  "source_severity": "high",
  "validation_status": "not_run"
},
