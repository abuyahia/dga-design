{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repository component inventory",
  "type": "object",
  "required": ["schema_version", "items"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "items": {"type": "array", "minItems": 1, "items": {
      "type": "object",
      "required": ["id", "semantic_id", "layer", "path", "status", "selection", "production_ready", "dependencies", "files"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "semantic_id": {"type": "string", "minLength": 1},
        "layer": {"enum": ["core", "composite", "partial", "section"]},
        "path": {"type": "string"},
        "status": {"enum": ["needs_improvement", "source_only", "planned", "ready"]},
        "selection": {"enum": ["canonical", "legacy", "not_implemented", "planned"]},
        "production_ready": {"enum": [true, false]},
        "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "files": {"type": "object"}
      }
    }}
  }
}
