{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Component reference 2.1 — normalized authoring envelope",
  "type": "object",
  "required": ["schema_version", "component", "axes", "axis_values", "variants", "variant_coverage"],
  "properties": {
    "schema_version": {"const": "2.1.0"},
    "component": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}}},
    "axes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "axis_values": {"type": "object", "additionalProperties": {"type": "array", "minItems": 1, "uniqueItems": true}},
    "variants": {"type": "array", "items": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string", "minLength": 1}, "axes": {"type": "object"}}}},
    "variant_coverage": {"enum": ["axes_only", "documented_subset", "complete"]}
  }
}
